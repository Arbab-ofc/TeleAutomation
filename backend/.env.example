# Optional alternative to entering credentials through the Settings page.
# Obtain these values from https://my.telegram.org/apps
# Dashboard-saved credentials in data/settings.json take precedence.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Runtime environment. Use production on the VPS.
APP_ENV=development
# Require HTTPS for the HttpOnly admin cookie in production.
COOKIE_SECURE=false
# Comma-separated browser origins allowed to call the local API.
# The defaults below are correct for the included Vite development server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# License portal access. Keep both values private and use long random strings.
ADMIN_ACCESS_CODE=replace-with-a-private-admin-code
LICENSE_TOKEN_SECRET=replace-with-a-long-random-signing-secret
ADMIN_TELEGRAM_USERNAME=your_telegram_username
# Firebase Realtime Database. Put the service-account JSON on one line or use a file path.
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_JSON=
# Safe restart recovery is opt-in. See README before enabling.
AUTOMATION_RESUME_ON_START=false
# Delivery cleanup is opt-in; conservative defaults retain 90 days and 10,000 records.
DELIVERY_RETENTION_ENABLED=false
DELIVERY_RETENTION_DAYS=90
DELIVERY_RETENTION_MAX_RECORDS=10000
DELIVERY_RETENTION_INTERVAL_SECONDS=3600
